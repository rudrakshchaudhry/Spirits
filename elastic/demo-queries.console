# SF Spirits — Elastic demo queries
# Paste into Kibana → Dev Tools (Console). Each block runs on its own.
# Coordinates: Valencia St & 20th (Mission) unless noted.

# ─────────────────────────────────────────────────────────────
# 1. "Spirits near me" — geo_distance + distance sort (spec §6.2 radar)
#    Every place in a 150 m radius across ALL datasets, nearest first.
# ─────────────────────────────────────────────────────────────
GET places/_search
{
  "size": 15,
  "_source": ["name", "kind", "neighborhood", "attrs.species", "attrs.business_category"],
  "query": {
    "bool": {
      "filter": { "geo_distance": { "distance": "150m", "location": { "lat": 37.7590, "lon": -122.4212 } } }
    }
  },
  "sort": [{ "_geo_distance": { "location": { "lat": 37.7590, "lon": -122.4212 }, "order": "asc", "unit": "m" } }]
}

# ─────────────────────────────────────────────────────────────
# 2. Cross-dataset geo join — "who are this spirit's neighbours?"
#    The exact grounding query used before Mistral writes a spirit:
#    places from OTHER datasets within 200 m of a street tree.
# ─────────────────────────────────────────────────────────────
GET places/_doc/tree:255621

GET places/_search
{
  "size": 5,
  "_source": ["name", "kind", "attrs.business_category", "attrs.year"],
  "query": {
    "bool": {
      "filter": [{ "geo_distance": { "distance": "200m", "location": { "lat": 37.75731, "lon": -122.41987 } } }],
      "must_not": [{ "term": { "kind": "tree" } }]
    }
  },
  "sort": [{ "_geo_distance": { "location": { "lat": 37.75731, "lon": -122.41987 }, "order": "asc", "unit": "m" } }]
}

# 2b. Shops within 60 m of the city's oldest street trees (filter on one dataset,
#     geo-join to another): ancient trees in the Mission, then paste one tree's location
#     into the second query to list the cafés/bakeries/restaurants within 60 m of it.
GET places/_search
{
  "size": 5,
  "_source": ["name", "attrs.species", "attrs.dbh", "location"],
  "query": { "bool": { "filter": [ { "term": { "kind": "tree" } }, { "term": { "tags": "ancient" } }, { "term": { "neighborhood": "Mission" } } ] } },
  "sort": [{ "rank": "desc" }]
}

GET places/_search
{
  "_source": ["name", "attrs.business_category"],
  "query": {
    "bool": {
      "filter": [
        { "term": { "kind": "business" } },
        { "terms": { "attrs.business_category": ["cafe", "bakery", "restaurant"] } },
        { "geo_distance": { "distance": "60m", "location": { "lat": 37.7590, "lon": -122.4212 } } }
      ]
    }
  }
}

# ─────────────────────────────────────────────────────────────
# 3. Aggregations
# ─────────────────────────────────────────────────────────────
# 3a. What lives in each neighbourhood (places per hood, split by dataset)
GET places/_search
{
  "size": 0,
  "aggs": {
    "hoods": {
      "terms": { "field": "neighborhood", "size": 41 },
      "aggs": { "kinds": { "terms": { "field": "kind" } } }
    }
  }
}

# 3b. Spirits already awakened (generated by Mistral) per neighbourhood + family
GET spirits/_search
{
  "size": 0,
  "query": { "term": { "status": "ready" } },
  "aggs": {
    "hoods": { "terms": { "field": "neighborhood", "size": 41 }, "aggs": { "family": { "terms": { "field": "family" } } } },
    "models": { "terms": { "field": "model" } }
  }
}

# 3c. Ancient trees per neighbourhood (where the rarest tree spirits live)
GET places/_search
{
  "size": 0,
  "query": { "bool": { "filter": [ { "term": { "kind": "tree" } }, { "term": { "tags": "ancient" } } ] } },
  "aggs": { "hoods": { "terms": { "field": "neighborhood", "size": 10 } } }
}

# ─────────────────────────────────────────────────────────────
# 4. Hybrid search — matching a spirit's wish to a real place (spec §6.2)
#    BM25 on the wish theme + kNN on mistral-embed vectors, fused with RRF,
#    filtered to places that yield the wished keepsake, excluding the
#    spirit's own neighbourhood. The query text is embedded inside ES via the
#    `mistral-embed` inference endpoint.
# ─────────────────────────────────────────────────────────────
GET places/_search
{
  "size": 3,
  "_source": ["name", "kind", "neighborhood", "keepsake_types"],
  "retriever": {
    "rrf": {
      "retrievers": [
        {
          "standard": {
            "query": {
              "bool": {
                "filter": [{ "term": { "keepsake_types": "film_ticket_stub" } }],
                "should": [{ "multi_match": { "query": "a love story by the bay", "fields": ["name^2", "description", "tags^2"] } }],
                "must_not": [{ "term": { "neighborhood": "Mission" } }]
              }
            }
          }
        },
        {
          "knn": {
            "field": "embedding",
            "query_vector_builder": { "text_embedding": { "model_id": "mistral-embed", "model_text": "a love story by the bay" } },
            "k": 20,
            "num_candidates": 200,
            "filter": { "bool": { "filter": [{ "term": { "keepsake_types": "film_ticket_stub" } }], "must_not": [{ "term": { "neighborhood": "Mission" } }] } }
          }
        }
      ],
      "rank_window_size": 50
    }
  }
}

# 4b. A real generated wish and where it points (after pre-warm)
GET spirits/_search
{
  "size": 3,
  "_source": ["name", "place_name", "neighborhood", "wish.theme", "wish.keepsake_type", "wish.riddle_1", "wish.target_place_ids", "wish.target_hoods", "model"],
  "query": { "term": { "status": "ready" } }
}
