# Elastic Cloud
ELASTICSEARCH_URL=
ELASTIC_CLOUD_ID=
ELASTICSEARCH_API_KEY=

# Mistral
MISTRAL_API_KEY=

# DataSF (optional, raises rate limits)
SOCRATA_APP_TOKEN=
SOCRATA_SECRET_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# random 32+ byte hex, signs encounter tokens
ENCOUNTER_SECRET=

# set to 1 only on local/demo builds (dev conditions panel, dev keepsake grants)
ALLOW_DEV_CONDITIONS=

# Vercel Cron bearer secret (cron routes reject everything else)
CRON_SECRET=

# optional: new guest accounts per IP per hour (default 10; 100 when ALLOW_DEV_CONDITIONS=1)
GUEST_LIMIT_PER_HOUR=

# optional: salt for hashing client IPs in the guest rate limit (defaults to the service-role key)
IP_HASH_SALT=
